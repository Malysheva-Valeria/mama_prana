---
import { languages, type Lang } from '@/i18n/content';
import { localizePath, useContent } from '@/i18n/utils';
import '@/styles/global.css';

const { lang, t } = useContent(Astro.currentLocale);

const canonical = new URL(localizePath('/', lang), Astro.site);
const ogImage = new URL('/og-image.svg', Astro.site);

/** hreflang per locale, x-default to uk */
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  hreflang: l,
  href: new URL(localizePath('/', l), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1e3a5f" />

    <!-- Set before first render to avoid a flash of visible .reveal blocks -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot />

    <script>
      // Scroll reveals; the only client script
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-anim], .logo--draw');

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target); // reveal once
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
        );

        targets.forEach((el) => observer.observe(el));
      }

      /* Hero is visible before any scroll, so trigger it after the first frame */

      /* Sun rises on each Hero entry; the first waits for the frame to draw */
      const sun = document.querySelector<HTMLElement>('.logo--sunrise');
      if (sun) {
        if (reduced || !('IntersectionObserver' in window)) {
          sun.classList.add('is-rising');
        } else {
          let seen = false;
          new IntersectionObserver(
            ([entry]) => {
              if (!entry) return;
              if (entry.isIntersecting) {
                if (seen) sun.style.setProperty('--rise-delay', '0.2s');
                seen = true;
                sun.classList.add('is-rising');
              } else {
                sun.classList.remove('is-rising');
              }
            },
            { threshold: 0.5 },
          ).observe(sun);
        }
      }

      requestAnimationFrame(() => {
        document
          .querySelectorAll<HTMLElement>('[data-anim-immediate], .hero .logo--draw')
          .forEach((el) => el.classList.add('is-visible'));
      });
    </script>
  </body>
</html>
