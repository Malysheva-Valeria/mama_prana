---
/** Section wrapper: theme, vertical padding, container. */
interface Props {
  id?: string;
  theme?: 'cream' | 'blue' | 'terracotta';
  /** Drop the container for full-width sections */
  bleed?: boolean;
  class?: string;
  labelledby?: string;
}

const { id, theme = 'cream', bleed = false, class: className, labelledby } = Astro.props;
---

<section
  id={id}
  data-theme={theme}
  aria-labelledby={labelledby}
  class:list={['section', className]}
>
  {
    bleed ? (
      <slot />
    ) : (
      <div class="container">
        <slot />
      </div>
    )
  }
</section>

<style>
  .section {
    background: var(--bg);
    color: var(--fg);
    padding-block: var(--space-xl);
  }
</style>
