---
import Section from './Section.astro';
import { useContent } from '@/i18n/utils';

const { t } = useContent(Astro.currentLocale);
---

<Section id="schedule" theme="blue" labelledby="schedule-title">
  <header class="schedule__header">
    <p class="eyebrow" data-anim="rise" style="--i: 0">{t.schedule.eyebrow}</p>
    <h2 id="schedule-title" class="schedule__title">
      <span class="line" data-anim="mask" style="--i: 1"><span>{t.schedule.title}</span></span>
    </h2>
  </header>

  <div class="schedule">
    {
      t.schedule.days.map((day, index) => (
        <section class="day" data-anim="rise" style={`--i: ${index}`}>
          <h3 class="day__name eyebrow">{day.day}</h3>
          <ul class="day__classes" role="list">
            {day.classes.map((item) => (
              <li class="class">
                <time class="class__time">{item.time}</time>
                <span class="class__name">{item.name}</span>
                {item.isNew && <span class="class__new">New!</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="schedule__note" data-anim="rise" style="--i: 4">{t.schedule.note}</p>
</Section>

<style>
  .schedule__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .schedule__title {
    font-size: var(--step-3);
    font-weight: 300;
  }

  .line {
    display: block;
    overflow: hidden;
  }

  .line > span {
    display: block;
  }

  .schedule {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    border-top: 1px solid var(--rule);
  }

  .day {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-md) var(--space-lg) 0;
    border-bottom: 1px solid var(--rule);
  }

  /* Accent line grows under the day on hover */
  .day::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease-drift);
  }

  .day:hover::after {
    transform: scaleX(1);
  }

  .day__name {
    color: var(--accent);
  }

  .day__classes {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
  }

  .class {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25em 0.9em;
  }

  .class__time {
    font-family: var(--font-label);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    color: var(--fg-soft);
  }

  .class__name {
    font-size: var(--step-1);
    font-weight: 300;
  }

  .class__new {
    padding: 0.1em 0.7em;
    border-radius: 999px;
    background: var(--accent);
    color: var(--c-cream-warm);
    font-family: var(--font-label);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }

  .schedule__note {
    margin-top: var(--space-lg);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--fg-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .day::after {
      transition: none;
    }
  }
</style>
