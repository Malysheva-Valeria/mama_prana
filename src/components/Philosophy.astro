---
import Photo from './Photo.astro';
import portrait from '@/assets/photos/philosophy.jpg';
import Section from './Section.astro';
import { useContent } from '@/i18n/utils';

const { t } = useContent(Astro.currentLocale);
---

<Section id="philosophy" theme="cream" labelledby="philosophy-title">
  <div class="philosophy">
    <div class="philosophy__text">
      <p class="eyebrow" data-anim="rise" style="--i: 0">{t.philosophy.eyebrow}</p>

      <h2 id="philosophy-title" class="philosophy__statement">
        <span class="line" data-anim="mask" style="--i: 1"
          ><span>{t.philosophy.statement}</span></span
        >
      </h2>

      {
        t.philosophy.body.map((paragraph, i) => (
          <p class="philosophy__body" data-anim="rise" style={`--i: ${2 + i}`}>
            {paragraph}
          </p>
        ))
      }
    </div>

    <div class="philosophy__media parallax" style="--parallax-from: 3rem; --parallax-to: -3rem">
      <Photo
        src={portrait}
        alt={t.philosophy.imageCaption}
        ratio="3 / 4"
        tone={2}
        anim="fade"
        index={2}
        kenBurns
      />
    </div>
  </div>
</Section>

<style>
  .philosophy {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .philosophy__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .philosophy__statement {
    font-size: var(--step-3);
    font-weight: 400;
    max-width: 16ch;
  }

  /* Mask for the reveal */
  .line {
    display: block;
    overflow: hidden;
  }

  .line > span {
    display: block;
  }

  .philosophy__body {
    color: var(--fg-soft);
  }

  @media (min-width: 52rem) {
    .philosophy {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-xl);
    }
  }
</style>
