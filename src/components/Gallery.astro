---
import Photo from './Photo.astro';
import hall from '@/assets/photos/hall.jpg';
import arches from '@/assets/photos/arches.jpg';
import morning from '@/assets/photos/morning.jpg';
import lounge from '@/assets/photos/lounge.jpg';
import details from '@/assets/photos/details.jpg';
import evening from '@/assets/photos/evening.jpg';
import Section from './Section.astro';
import { useContent } from '@/i18n/utils';

const { t } = useContent(Astro.currentLocale);

const photos = [hall, arches, morning, lounge, details, evening];
---

<Section id="space" theme="cream" labelledby="space-title">
  <header class="gallery__header">
    <p class="eyebrow" data-anim="rise" style="--i: 0">{t.gallery.eyebrow}</p>
    <h2 id="space-title" class="gallery__title">
      <span class="line" data-anim="mask" style="--i: 1"><span>{t.gallery.title}</span></span>
    </h2>
  </header>

  <div class="gallery">
    {
      t.gallery.captions.map((caption, index) => (
        <div class="gallery__cell">
          <Photo
            src={photos[index]}
            alt={caption}
            caption={caption}
            ratio="4 / 5"
            tone={((index % 3) + 1) as 1 | 2 | 3}
            anim="fade"
            index={index % 3}
            kenBurns
          />
        </div>
      ))
    }
  </div>
</Section>

<style>
  .gallery__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .gallery__title {
    font-size: var(--step-3);
    font-weight: 400;
  }

  .line {
    display: block;
    overflow: hidden;
  }

  .line > span {
    display: block;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-md);
    align-items: start;
  }
</style>
