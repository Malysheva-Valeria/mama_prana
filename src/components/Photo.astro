---
/** Photo from `src/assets/`; without `src`, a brand-colored placeholder. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Imported file from `src/assets/` */
  src?: ImageMetadata;
  alt?: string;
  caption?: string;
  /** CSS aspect-ratio, e.g. '3 / 4' */
  ratio?: string;
  /** Placeholder fill variant */
  tone?: 1 | 2 | 3;
  /** Reveal type; `false` disables */
  anim?: 'fade' | 'rise' | false;
  /** Stagger order */
  index?: number;
  /** Slow zoom while in view */
  kenBurns?: boolean;
  class?: string;
}

const {
  src,
  alt = '',
  caption,
  ratio = '3 / 4',
  tone = 1,
  anim = 'fade',
  index = 0,
  kenBurns = false,
  class: className,
} = Astro.props;
---

<figure class:list={['photo', className]} style={`--ratio: ${ratio}`}>
  <div class="photo__frame">
    {
      src ? (
        <Image
          src={src}
          alt={alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 52rem) 33vw, 100vw"
          class:list={['photo__image', kenBurns && 'ken-burns']}
          data-anim={anim === false ? undefined : anim}
          style={`--i: ${index}`}
        />
      ) : (
        <div
          class:list={['photo__placeholder', kenBurns && 'ken-burns']}
          data-tone={tone}
          data-anim={anim === false ? undefined : anim}
          style={`--i: ${index}`}
          aria-hidden="true"
        />
      )
    }
  </div>

  {
    caption && (
      <figcaption class="eyebrow photo__caption" data-anim="rise" style={`--i: ${index + 1}`}>
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .photo {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Frame clips the zoom */
  .photo__frame {
    overflow: hidden;
  }

  .photo__image {
    display: block;
    aspect-ratio: var(--ratio);
    width: 100%;
    object-fit: cover;
    transition: scale var(--dur-xslow) var(--ease-drift);
  }

  .photo:hover .photo__image {
    scale: 1.03;
  }

  .photo__placeholder {
    aspect-ratio: var(--ratio);
    width: 100%;
    background:
      linear-gradient(135deg, transparent 48%, var(--rule) 49%, var(--rule) 51%, transparent 52%),
      var(--fill);
    background-size:
      2.5rem 2.5rem,
      cover;
    transition: scale var(--dur-xslow) var(--ease-drift);
  }

  .photo:hover .photo__placeholder {
    scale: 1.03;
  }

  .photo__placeholder[data-tone='1'] {
    --fill: color-mix(in srgb, var(--c-muted-blue) 45%, var(--bg));
  }

  .photo__placeholder[data-tone='2'] {
    --fill: color-mix(in srgb, var(--c-blue) 22%, var(--bg));
  }

  .photo__placeholder[data-tone='3'] {
    --fill: color-mix(in srgb, var(--c-terracotta) 20%, var(--bg));
  }

  .photo__caption {
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo:hover .photo__placeholder,
    .photo:hover .photo__image {
      scale: 1;
    }
  }
</style>
