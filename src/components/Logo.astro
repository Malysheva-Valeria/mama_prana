---
/** Brand symbol: sunrise in a square. Inline SVG, inherits `currentColor`. */
interface Props {
  /** Square side */
  size?: string;
  /** Show wordmark below the symbol */
  withWordmark?: boolean;
  /** Draw the outline on reveal */
  draw?: boolean;
  /** Sun rises once, then rays spin */
  sunrise?: boolean;
  class?: string;
}

const {
  size = '7rem',
  withWordmark = false,
  draw = false,
  sunrise = false,
  class: className,
} = Astro.props;

// Sunrise rays, symmetric from the horizon
const rays = [0, 30, 60, 90, 120, 150, 180];
// Full ring of rays for spinning; clipPath hides those below the horizon
const spinRays = Array.from({ length: 12 }, (_, i) => i * 30);

const ray = (deg: number) => {
  const rad = (deg * Math.PI) / 180;
  return {
    x1: 50 - Math.cos(rad) * 23,
    y1: 68 - Math.sin(rad) * 23,
    x2: 50 - Math.cos(rad) * 30,
    y2: 68 - Math.sin(rad) * 30,
  };
};
---

<div
  class:list={['logo', draw && 'logo--draw', sunrise && 'logo--sunrise', className]}
  style={`--logo-size: ${size}`}
  data-anim-immediate={draw ? '' : undefined}
>
  <!-- Decorative when a text logo sits beside it -->
  <svg
    viewBox="0 0 100 100"
    role={withWordmark ? 'presentation' : 'img'}
    aria-label={withWordmark ? undefined : 'mama prana'}
    aria-hidden={withWordmark ? 'true' : undefined}
    fill="none"
  >
    <!-- pathLength=1 lets one stroke animation fit every line -->
    <rect
      x="1"
      y="1"
      width="98"
      height="98"
      stroke="currentColor"
      stroke-width="1.5"
      pathLength="1"
      data-draw
      style="--d: 0"></rect>

    <!-- horizon -->
    <line
      x1="18"
      y1="68"
      x2="82"
      y2="68"
      stroke="currentColor"
      stroke-width="1.5"
      pathLength="1"
      data-draw
      style="--d: 1"></line>

    {
      sunrise ? (
        <>
          <defs>
            <clipPath id="logo-horizon-clip">
              <rect x="0" y="0" width="100" height="68" />
            </clipPath>
          </defs>
          <g clip-path="url(#logo-horizon-clip)">
            <g class="logo__sun" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M 33 68 A 17 17 0 0 1 67 68" />
              <g class="logo__rays">
                {spinRays.map((deg) => (
                  <line {...ray(deg)} />
                ))}
              </g>
            </g>
          </g>
        </>
      ) : (
        <>
          {/* sun arc */}
          <path
            d="M 33 68 A 17 17 0 0 1 67 68"
            stroke="currentColor"
            stroke-width="1.5"
            pathLength="1"
            data-draw
            style="--d: 2"
          />

          {/* rays */}
          {rays.map((deg, i) => (
            <line
              {...ray(deg)}
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              pathLength="1"
              data-draw
              style={`--d: ${3 + i * 0.5}`}
            />
          ))}
        </>
      )
    }
  </svg>

  {withWordmark && <span class="logo__wordmark">mama prana</span>}
</div>

<style>
  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    color: currentColor;
  }

  .logo svg {
    width: var(--logo-size);
    height: var(--logo-size);
  }

  .logo__wordmark {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 1;
  }
</style>
