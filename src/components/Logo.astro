---
/**
 * Символ бренду: схід сонця у квадраті.
 * Квадрат — стабільність, промені — енергія. Разом = mama prana.
 * Малюємо inline-SVG, щоб він успадковував колір секції через `currentColor`.
 */
interface Props {
  /** Розмір сторони квадрата */
  size?: string;
  /** Показувати словесний знак під символом */
  withWordmark?: boolean;
  /** Промальовувати обводку при появі */
  draw?: boolean;
  class?: string;
}

const { size = '7rem', withWordmark = false, draw = false, class: className } = Astro.props;

// Промені сходу: кути від горизонту, симетрично
const rays = [0, 30, 60, 90, 120, 150, 180];
---

<div
  class:list={['logo', draw && 'logo--draw', className]}
  style={`--logo-size: ${size}`}
  data-anim-immediate={draw ? '' : undefined}
>
  <!-- Якщо поруч є текстовий логотип, символ стає декоративним:
       інакше скрінрідер прочитав би «mama prana» двічі поспіль. -->
  <svg
    viewBox="0 0 100 100"
    role={withWordmark ? 'presentation' : 'img'}
    aria-label={withWordmark ? undefined : 'mama prana'}
    aria-hidden={withWordmark ? 'true' : undefined}
    fill="none"
  >
    <!-- pathLength=1 нормалізує довжину кожної лінії, тож одна анімація
         штриха однаково працює і для рамки, і для дуги, і для променя. -->
    <rect
      x="1"
      y="1"
      width="98"
      height="98"
      stroke="currentColor"
      stroke-width="1.5"
      pathLength="1"
      data-draw
      style="--d: 0"></rect>

    <!-- горизонт -->
    <line
      x1="18"
      y1="68"
      x2="82"
      y2="68"
      stroke="currentColor"
      stroke-width="1.5"
      pathLength="1"
      data-draw
      style="--d: 1"></line>

    <!-- півколо сонця -->
    <path
      d="M 33 68 A 17 17 0 0 1 67 68"
      stroke="currentColor"
      stroke-width="1.5"
      pathLength="1"
      data-draw
      style="--d: 2"></path>

    <!-- промені -->
    {
      rays.map((deg, i) => {
        const rad = (deg * Math.PI) / 180;
        const inner = 23;
        const outer = 30;
        return (
          <line
            x1={50 - Math.cos(rad) * inner}
            y1={68 - Math.sin(rad) * inner}
            x2={50 - Math.cos(rad) * outer}
            y2={68 - Math.sin(rad) * outer}
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            pathLength="1"
            data-draw
            style={`--d: ${3 + i * 0.5}`}
          />
        );
      })
    }
  </svg>

  {withWordmark && <span class="logo__wordmark">mama prana</span>}
</div>

<style>
  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    color: currentColor;
  }

  .logo svg {
    width: var(--logo-size);
    height: var(--logo-size);
  }

  .logo__wordmark {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 1;
  }
</style>
