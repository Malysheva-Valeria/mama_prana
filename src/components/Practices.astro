---
import Photo from './Photo.astro';
import body from '@/assets/photos/body.jpg';
import face from '@/assets/photos/face.jpg';
import retreats from '@/assets/photos/retreats.jpg';
import Section from './Section.astro';
import { useContent } from '@/i18n/utils';

const { t } = useContent(Astro.currentLocale);

const photos = { body, face, retreats };

/** Three bands with alternating colors */
const themes = ['blue', 'terracotta', 'cream'] as const;
---

<div id="practices">
  {
    t.practices.items.map((item, index) => {
      const theme = themes[index % themes.length] ?? 'cream';
      const titleId = `practice-${item.id}`;
      return (
        <Section id={item.id} theme={theme} labelledby={titleId}>
          <article class="practice" data-flip={index % 2 === 1}>
            {/* Ghost number: parallax, static opacity */}
            <span class="practice__ghost parallax" aria-hidden="true">{`0${index + 1}`}</span>

            <div class="practice__text">
              <p class="eyebrow" data-anim="rise" style="--i: 0">
                {t.practices.eyebrow}
                <span class="practice__index">{`0${index + 1}`}</span>
              </p>

              <h2 id={titleId} class="practice__name">
                <span class="line" data-anim="mask" style="--i: 1">
                  <span>{item.name}</span>
                </span>
              </h2>

              <p class="practice__tagline" data-anim="rise" style="--i: 2">
                {item.tagline}
              </p>

              <hr class="practice__rule" data-anim="line" style="--i: 3" />

              <p class="practice__description" data-anim="rise" style="--i: 4">
                {item.description}
              </p>
            </div>

            <div
              class="practice__media parallax"
              style={`--parallax-from: ${index % 2 ? '-3.5rem' : '3.5rem'}; --parallax-to: ${index % 2 ? '3.5rem' : '-3.5rem'}`}
            >
              <Photo
                src={photos[item.id as keyof typeof photos]}
                alt={item.name}
                ratio="4 / 5"
                tone={((index % 3) + 1) as 1 | 2 | 3}
                anim="fade"
                index={2}
                kenBurns
              />
            </div>
          </article>
        </Section>
      );
    })
  }
</div>

<style>
  .practice {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  /* Ghost number: near-invisible, sets the section scale */
  .practice__ghost {
    position: absolute;
    top: -0.35em;
    inset-inline-start: -0.08em;
    font-family: var(--font-display);
    font-size: clamp(9rem, 26vw, 22rem);
    font-weight: 300;
    line-height: 1;
    color: var(--fg);
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .practice__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .practice__index::before {
    content: '—';
    margin-inline: 0.6em;
    opacity: 0.6;
  }

  .practice__name {
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .line {
    display: block;
    overflow: hidden;
  }

  .line > span {
    display: block;
  }

  .practice__tagline {
    font-style: italic;
    font-size: var(--step-1);
    color: var(--accent);
  }

  .practice__rule {
    width: 100%;
    max-width: 5rem;
    height: 1px;
    border: 0;
    margin-block: var(--space-sm);
    background: var(--rule);
    transform-origin: left;
  }

  .practice__description {
    color: var(--fg-soft);
  }

  .practice__media {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 52rem) {
    .practice {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    /* Mirror every second block */
    .practice[data-flip='true'] .practice__text {
      order: 2;
    }

    .practice[data-flip='true'] .practice__ghost {
      inset-inline-start: auto;
      inset-inline-end: -0.08em;
    }
  }
</style>
