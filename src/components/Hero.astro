---
import Logo from './Logo.astro';
import { useContent } from '@/i18n/utils';

const { t } = useContent(Astro.currentLocale);

// Мантра розбивається на фрази — кожна виїжджає з-під маски по черзі
const phrases = t.hero.mantra.split(/(?<=\.)\s+/).filter(Boolean);
---

<section id="top" class="hero" data-theme="blue">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner hero-fade">
    <p class="eyebrow hero__eyebrow" data-anim="letters" data-anim-immediate style="--i: 0">
      {t.hero.eyebrow}
    </p>

    <Logo size="clamp(5rem, 12vw, 8.5rem)" withWordmark draw class="hero__logo" />

    <h1 class="hero__mantra">
      {
        phrases.map((phrase, i) => (
          <span class="hero__line" data-anim="mask" data-anim-immediate style={`--i: ${5 + i}`}>
            <span>{phrase}</span>
          </span>
        ))
      }
    </h1>
  </div>

  <a class="hero__scroll" href="#philosophy" data-anim="rise" data-anim-immediate style="--i: 8">
    <span class="eyebrow">{t.hero.scrollHint}</span>
    <span class="hero__scroll-line scroll-cue" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    background: var(--bg);
    color: var(--fg);
    text-align: center;
    overflow: hidden;
  }

  /* Тепле світло за логотипом — натяк на схід сонця, не ілюстрація */
  .hero__glow {
    position: absolute;
    top: 42%;
    left: 50%;
    width: min(120vw, 60rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-terracotta) 26%, transparent) 0%,
      transparent 62%
    );
    pointer-events: none;
    animation: breathe 11s ease-in-out infinite;
  }

  /* Повільне «дихання» — єдиний нескінченний рух на сторінці */
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.55;
      scale: 1;
    }
    50% {
      opacity: 0.9;
      scale: 1.09;
    }
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero__eyebrow {
    color: var(--c-muted-blue);
  }

  .hero__mantra {
    font-size: var(--step-2);
    font-weight: 300;
    font-style: italic;
    max-width: 22ch;
    color: var(--fg-soft);
  }

  /* Маска для кожного рядка: те, що зсунуте вниз, за неї не виходить */
  .hero__line {
    display: block;
    overflow: hidden;
  }

  .hero__line > span {
    display: block;
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--c-muted-blue);
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 3.5rem;
    background: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__glow {
      animation: none;
    }
  }
</style>
