---
import Logo from './Logo.astro';
import { useContent } from '@/i18n/utils';

const { t } = useContent(Astro.currentLocale);

// Each mantra phrase reveals in turn
const phrases = t.hero.mantra.split(/(?<=\.)\s+/).filter(Boolean);
---

<section id="top" class="hero" data-theme="green">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner hero-fade">
    <p class="eyebrow hero__eyebrow" data-anim="letters" data-anim-immediate style="--i: 0">
      {t.hero.eyebrow}
    </p>

    <Logo size="clamp(5rem, 12vw, 8.5rem)" withWordmark draw sunrise class="hero__logo" />

    <h1 class="hero__mantra">
      {
        phrases.map((phrase, i) => (
          <span class="hero__line" data-anim="mask" data-anim-immediate style={`--i: ${5 + i}`}>
            <span>{phrase}</span>
          </span>
        ))
      }
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    background: var(--bg);
    color: var(--fg);
    text-align: center;
    overflow: hidden;
  }

  /* Warm glow behind the logo, a hint of sunrise */
  .hero__glow {
    position: absolute;
    top: 42%;
    left: 50%;
    width: min(120vw, 60rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-orange) 26%, transparent) 0%,
      transparent 62%
    );
    pointer-events: none;
    animation: breathe 11s ease-in-out infinite;
  }

  /* Slow breathing, the only endless motion */
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.55;
      scale: 1;
    }
    50% {
      opacity: 0.9;
      scale: 1.09;
    }
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero__eyebrow {
    color: var(--c-sand);
  }

  .hero__mantra {
    font-size: var(--step-2);
    font-weight: 400;
    font-style: italic;
    max-width: 22ch;
    color: var(--fg-soft);
  }

  /* Mask for each line; shifted text stays clipped */
  .hero__line {
    display: block;
    overflow: hidden;
  }

  .hero__line > span {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__glow {
      animation: none;
    }
  }
</style>
